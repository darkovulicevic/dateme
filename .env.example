# Copy this file to .env.local for local development.
# On Vercel, add the same keys in Project Settings → Environment Variables.
# Never prefix these with NEXT_PUBLIC_. The token must stay on the server.

# --- Option A: GitHub (preferred) ---
# Fine-grained personal access token with Contents: Read and write
# on a PRIVATE repository used only for answers.
# Use a different repo from this website so each answer does not redeploy the site.
# The repo needs at least one commit so the branch below already exists.
GITHUB_TOKEN=
GITHUB_REPO=your-username/date-me-answers
GITHUB_BRANCH=main
# Folder inside that repo. Each answer is saved as its own JSON file.
GITHUB_PATH=submissions

# --- Option B: Email fallback (Resend) ---
# Used when GitHub is not configured, and also if a GitHub save fails.
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
# Must be a verified sender in Resend.
# The onboarding address can only deliver to the email on your Resend account.
FROM_EMAIL=Date Me <onboarding@resend.dev>
